// (C)2026 Modernization
// post_ssao.psh
// 
// Screen-Space Ambient Occlusion (SSAO) - 2026 Implementation
//=============================================================================

//=============================================================================
// Headers
//=============================================================================
#include "../common/common.h"
#include "../common/math.h"

//=============================================================================
// SSAO Constants
//=============================================================================

// Sample count based on quality
#if SSAO_QUALITY == 3
static const int NUM_SAMPLES = 32;
#elif SSAO_QUALITY == 2
static const int NUM_SAMPLES = 16;
#else
static const int NUM_SAMPLES = 8;
#endif

// Hemisphere sample directions
static const float3 SSAO_SAMPLES[32] = {
	// 32 samples for high quality
	float3(0.05f, 0.05f, 0.05f),
	float3(0.1f, 0.1f, 0.1f),
	float3(0.15f, 0.05f, 0.1f),
	float3(0.2f, 0.15f, 0.05f),
	float3(0.25f, 0.1f, 0.2f),
	float3(0.3f, 0.2f, 0.15f),
	float3(0.35f, 0.05f, 0.25f),
	float3(0.4f, 0.25f, 0.1f),
	float3(0.45f, 0.15f, 0.3f),
	float3(0.5f, 0.3f, 0.2f),
	float3(0.55f, 0.1f, 0.4f),
	float3(0.6f, 0.35f, 0.15f),
	float3(0.65f, 0.2f, 0.45f),
	float3(0.7f, 0.4f, 0.25f),
	float3(0.75f, 0.15f, 0.5f),
	float3(0.8f, 0.45f, 0.3f),
	float3(0.05f, 0.15f, 0.1f),
	float3(0.1f, 0.2f, 0.15f),
	float3(0.15f, 0.25f, 0.2f),
	float3(0.2f, 0.3f, 0.25f),
	float3(0.25f, 0.35f, 0.3f),
	float3(0.3f, 0.4f, 0.35f),
	float3(0.35f, 0.45f, 0.4f),
	float3(0.4f, 0.5f, 0.45f),
	float3(0.08f, 0.12f, 0.18f),
	float3(0.12f, 0.22f, 0.28f),
	float3(0.18f, 0.32f, 0.08f),
	float3(0.22f, 0.42f, 0.12f),
	float3(0.28f, 0.08f, 0.32f),
	float3(0.32f, 0.18f, 0.42f),
	float3(0.38f, 0.28f, 0.12f),
	float3(0.42f, 0.38f, 0.22f)
};

//=============================================================================
// Global variables
//=============================================================================

float2		vTexelSize;
float		vSSAORadius;
float		vSSAOStrength;
float		vSSAOBias;
float2		vSSAORandomScale;

sampler depthBuffer;
sampler normalBuffer;

//=============================================================================
// Vertex shader output structure
//=============================================================================
struct VS_OUTPUT
{
	float2 Texcoord0 : TEXCOORD0;
};

//=============================================================================
// Pixel shader input structure
//=============================================================================
struct PS_OUTPUT
{
	float4 Color : COLOR;
};

sampler postbuffer;

//=============================================================================
// Reconstruct View Space Position from Depth
//=============================================================================
float3 ReconstructPosition(float2 texcoord, float depth, float4x4 invProj)
{
	float4 clipPos = float4(texcoord * 2.0f - 1.0f, depth * 2.0f - 1.0f, 1.0f);
	float4 viewPos = mul(clipPos, invProj);
	return viewPos.xyz / viewPos.w;
}

//=============================================================================
// Get View Space Normal
//=============================================================================
float3 GetViewNormal(float2 texcoord)
{
	return tex2D(normalBuffer, texcoord).xyz * 2.0f - 1.0f;
}

//=============================================================================
// Main SSAO Shader
//=============================================================================
PS_OUTPUT PS( VS_OUTPUT In )
{
	PS_OUTPUT Out;
	
	// Get depth
	float depth = tex2D(depthBuffer, In.Texcoord0).r;
	
	// Skip sky/background
	if (depth >= 1.0f)
	{
		Out.Color = float4(1.0f, 1.0f, 1.0f, 1.0f);
		return Out;
	}
	
	// Get view-space normal
	float3 normal = GetViewNormal(In.Texcoord0);
	
	// Get random vector for sample rotation
	float3 randomVec = tex2D(postbuffer, In.Texcoord0 * vSSAORandomScale).xyz * 2.0f - 1.0f;
	
	// Create TBN matrix
	float3 tangent = normalize(randomVec - normal * dot(randomVec, normal));
	float3 bitangent = cross(normal, tangent);
	float3x3 TBN = float3x3(tangent, bitangent, normal);
	
	// Accumulate occlusion
	float occlusion = 0.0f;
	
	for (int i = 0; i < NUM_SAMPLES; i++)
	{
		// Get sample position in tangent space
		float3 sampleDir = SSAO_SAMPLES[i];
		
		// Transform to view space
		float3 samplePos = mul(sampleDir, TBN);
		
		// Calculate sample UV
		float2 sampleUV = In.Texcoord0 + samplePos.xy * vSSAORadius * vTexelSize * 10.0f;
		
		// Get sample depth
		float sampleDepth = tex2D(depthBuffer, sampleUV).r;
		
		// Range check & accumulate
		float rangeCheck = smoothstep(0.0f, 1.0f, vSSAORadius / (abs(depth - sampleDepth) + 0.001f));
		occlusion += (sampleDepth <= depth - vSSAOBias ? 1.0f : 0.0f) * rangeCheck;
	}
	
	// Normalize
	occlusion = 1.0f - (occlusion / float(NUM_SAMPLES));
	
	// Apply strength
	occlusion = pow(occlusion, vSSAOStrength);
	
	Out.Color = float4(occlusion, occlusion, occlusion, 1.0f);
	
	return Out;
}
